# Redis connection
REDIS_URL=redis://localhost:6379/0

# TTL for stored JSON objects (seconds)
REDIS_TTL=86400

# Optional prefix for all Redis keys; leave empty to disable
# REDIS_PREFIX=dev

# URL of external preview service used by resolve_continue_url


# RETURNURL_REGEX Regular expression to validate return URLs for security
# RETURNURL_REGEX=^https://example.com/
RETURNURL_REGEX=.*


# Logging configuration
LOGGING_LEVEL=DEBUG
LOGGING_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
LOGGING_DATE="%Y-%m-%d %H:%M:%S"

EIDAS_SPECIFIC_CONNECTOR_URL=https://connector.eidas.k8s/SpecificConnector/ServiceProvider
EIDAS_SP_PROVIDER_NAME=OOTS-EIDAS
EIDAS_SP_REQUESTER_ID=https://oots.example.org/RequesterId_UA
EIDAS_SP_CITIZEN_COUNTRY=UA
EIDAS_SP_LOA=A
EIDAS_SP_TYPE=public
